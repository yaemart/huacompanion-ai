# Copy values through your hosting secret manager; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hua_companion
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://127.0.0.1:3000
APP_ENV=local
# Search indexing is permitted only with APP_ENV=production AND this explicit opt-in.
SEARCH_ENGINE_INDEXING=false
# Trial public languages. Keep other translations implemented but hidden.
SITE_LOCALES=en,zh
VISA_CHECKER_ENABLED=false
# Optional exact contentKey of a published visa application guide (en/zh).
VISA_GUIDE_CONTENT_KEY=
# Trust no forwarded IP headers unless an authenticated gateway is configured.
# cloudflare reads CF-Connecting-IP; nginx reads X-Real-IP. Never trust client X-Forwarded-For.
TRUSTED_PROXY=
# Gateway overwrites X-Hua-Proxy-Secret; use at least 32 random characters.
# Block direct origin access too. See docs/trial-deployment.md before enabling.
TRUSTED_PROXY_SECRET=
NEXT_PUBLIC_FORM_MODE=local
# External email delivery remains disabled until explicitly configured.

# Optional support services: keep blank until a compatible service is configured.
# Protocols and rollout checklist: docs/customer-support.md, support-voice.md, support-calls.md
SUPPORT_AI_ENDPOINT=
SUPPORT_AI_KEY=
SUPPORT_AI_MODEL=
SUPPORT_AI_DAILY_TOKENS=0
SUPPORT_AI_CONVERSATION_TOKENS=100000
SUPPORT_SPEECH_ENDPOINT=
SUPPORT_SPEECH_KEY=
SUPPORT_SPEECH_DAILY_UNITS=0
SUPPORT_CALL_GATEWAY_URL=
SUPPORT_CALL_GATEWAY_KEY=
SUPPORT_CALL_AI_ENABLED=false
SUPPORT_CALL_MAX_SECONDS=300
SUPPORT_CALL_CONCURRENCY=3
SUPPORT_CALL_DAILY_SECONDS=3600
# Set the verified upper-bound rate and a daily spend cap before enabling calls.
SUPPORT_CALL_MAX_CENTS_PER_MINUTE=0
SUPPORT_CALL_DAILY_CENTS=0

# Optional transactional email. Configure verified sender in Resend first.
# Both environment and admin feature settings must explicitly enable delivery.
WORKFLOW_MAIL_ENABLED=false
WORKFLOW_MAIL_API_KEY=
WORKFLOW_MAIL_FROM=

# Trial only: keep disabled until deployment, policies and operational checks pass.
INTAKE_ENABLED=false
PRIVACY_VERSION=

# Optional business proposal JSON gateway; disabled by default.
BUSINESS_AI_ENABLED=false
BUSINESS_AI_ENDPOINT=
BUSINESS_AI_KEY=
BUSINESS_AI_MODEL=
BUSINESS_AI_DAILY_TOKENS=0
